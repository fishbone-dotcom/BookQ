<div class="w-full max-w-sm mx-auto">
  <h2 class="text-2xl font-bold text-gray-900 mb-6">Log in</h2>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="mb-4">
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500" %>
    </div>

    <div class="mb-4">
      <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="mb-6 flex items-center gap-2">
        <%= f.check_box :remember_me, class: "rounded border-gray-300" %>
        <%= f.label :remember_me, class: "text-sm text-gray-600" %>
      </div>
    <% end %>

    <%= f.submit "Log in", class: "w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2 rounded-lg cursor-pointer transition" %>
  <% end %>

  <div class="mt-6 text-sm text-gray-600 flex flex-col gap-1">
    <%= render "devise/shared/links" %>
  </div>
</div>
