<% if user_signed_in? %>
  <div class="w-full max-w-md mx-auto flex flex-col gap-5">
    <div class="relative bg-gradient-to-br from-emerald-600 to-emerald-800 rounded-2xl px-5 pt-5 pb-10 text-white shadow-sm">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-lg font-semibold truncate">Hello, <%= current_user.display_name %> 👋</p>
          <p class="text-emerald-100 text-sm">How are you feeling today?</p>
        </div>
        <span class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center shrink-0">
          <%= render "icons/bell", size: 17 %>
        </span>
      </div>
    </div>

    <div class="-mt-9 px-1" data-controller="clinic-search">
      <div class="relative mb-1">
        <%= render "icons/search", size: 16, class: "absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400" %>
        <input type="text" placeholder="Search clinics..." autocomplete="off"
          data-clinic-search-target="input" data-action="input->clinic-search#filter"
          class="w-full bg-white border border-gray-200 rounded-xl shadow-sm pl-10 pr-4 py-3 text-sm text-gray-700 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-500">
      </div>

      <% if @clinics.present? %>
        <div class="mt-5">
          <h2 class="text-sm font-semibold text-gray-800 mb-3 px-1">Book an Appointment</h2>
          <div class="grid grid-cols-3 sm:grid-cols-4 gap-3">
            <% @clinics.each do |clinic| %>
              <%= link_to clinic_booking_path(clinic), class: "flex flex-col items-center gap-1.5 text-center group",
                    data: { clinic_search_target: "item", clinic_search_name: clinic.name.downcase } do %>
                <span class="w-14 h-14 rounded-2xl bg-emerald-50 group-hover:bg-emerald-100 text-emerald-600 flex items-center justify-center transition">
                  <%= render "icons/building", size: 20 %>
                </span>
                <span class="text-[11px] text-gray-600 leading-tight line-clamp-2"><%= clinic.name %></span>
              <% end %>
            <% end %>
          </div>
          <p data-clinic-search-target="empty" class="hidden text-center text-sm text-gray-400 py-4">No clinics found.</p>
        </div>
      <% else %>
        <p class="text-center text-sm text-gray-500 mt-5">No clinics available yet.</p>
      <% end %>
    </div>

    <div>
      <h2 class="text-sm font-semibold text-gray-800 mb-3 px-1">Upcoming Appointment</h2>

      <% if @active_appointment %>
        <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-11 h-11 rounded-full bg-emerald-100 text-emerald-700 font-semibold text-sm flex items-center justify-center shrink-0">
              <%= initials_for(@active_appointment.staff) %>
            </span>
            <div class="min-w-0">
              <p class="text-sm font-semibold text-gray-900 truncate"><%= @active_appointment.staff&.display_name || "Staff — TBA" %></p>
              <p class="text-xs text-gray-500 truncate"><%= @active_appointment.service.name %></p>
            </div>
          </div>

          <div class="flex flex-col gap-1.5 text-xs text-gray-500 mb-4">
            <div class="flex items-center gap-1.5">
              <%= render "icons/calendar", size: 14, class: "shrink-0" %>
              <%= I18n.l(@active_appointment.starts_at.to_date, format: :long) %>
            </div>
            <div class="flex items-center gap-1.5">
              <%= render "icons/clock", size: 14, class: "shrink-0" %>
              <%= @active_appointment.starts_at.strftime("%I:%M %p") %>
            </div>
            <div class="flex items-center gap-1.5">
              <%= render "icons/map_pin", size: 14, class: "shrink-0" %>
              <%= @active_appointment.clinic.name %>
            </div>
          </div>

          <%= link_to "View Appointment", clinic_booking_path(@active_appointment.clinic),
                class: "block w-full text-center bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium py-2.5 rounded-lg transition" %>
        </div>
      <% else %>
        <div class="bg-white border border-gray-200 rounded-xl p-4 text-center text-sm text-gray-500 shadow-sm">
          You don't have an upcoming appointment yet.
        </div>
      <% end %>
    </div>

    <div class="flex items-center justify-center gap-4 pt-2">
      <% if current_user.admin? %>
        <%= link_to "Admin Dashboard", admin_dashboard_path, class: "text-xs text-gray-500 hover:text-gray-700 font-medium" %>
        <span class="text-gray-300">&middot;</span>
      <% end %>
      <% if current_user.clinics.any? %>
        <%= link_to "Staff Dashboard", staff_dashboard_path, class: "text-xs text-gray-500 hover:text-gray-700 font-medium" %>
        <span class="text-gray-300">&middot;</span>
      <% end %>
      <%= button_to "Log out", destroy_user_session_path, method: :delete, data: { turbo: false },
            class: "text-xs text-gray-500 hover:text-gray-700 font-medium cursor-pointer bg-transparent" %>
    </div>
  </div>
<% else %>
  <div class="w-full max-w-sm mx-auto text-center">
    <h1 class="font-bold text-3xl text-gray-900 mb-2">BookQ</h1>
    <p class="text-gray-500 text-sm mb-6">Clinic booking, no more Messenger back-and-forth.</p>

    <p class="mb-6 text-gray-500 text-sm">You're not logged in yet.</p>
    <div class="flex flex-col gap-3">
      <%= link_to "Sign up", new_user_registration_path, class: "bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2 rounded-lg transition" %>
      <%= link_to "Log in", new_user_session_path, class: "bg-gray-100 hover:bg-gray-200 text-gray-800 font-medium py-2 rounded-lg transition" %>
    </div>
  </div>
<% end %>
