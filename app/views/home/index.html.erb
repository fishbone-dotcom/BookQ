<% if user_signed_in? %>
  <div class="w-full max-w-md lg:max-w-4xl mx-auto flex flex-col gap-5">
    <div class="relative bg-gradient-to-br from-emerald-600 to-emerald-800 rounded-2xl px-5 pt-5 pb-10 lg:pb-5 text-white shadow-sm">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <p class="text-lg font-semibold truncate">Hello, <%= current_user.display_name %> 👋</p>
          <p class="text-emerald-100 text-sm">How are you feeling today?</p>
        </div>
        <span class="w-9 h-9 rounded-full bg-white/15 flex items-center justify-center shrink-0">
          <%= render "icons/bell", size: 17 %>
        </span>
      </div>
    </div>

    <div class="lg:grid lg:grid-cols-3 lg:gap-6 lg:items-start">
      <div class="-mt-9 lg:mt-0 lg:col-span-2 px-1" data-controller="clinic-search">
        <div class="relative mb-1">
          <%= render "icons/search", size: 16, class: "absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400" %>
          <input type="text" placeholder="Search clinics..." autocomplete="off"
            data-clinic-search-target="input" data-action="input->clinic-search#filter"
            class="w-full bg-white border border-gray-200 rounded-xl shadow-sm pl-10 pr-4 py-3 text-sm text-gray-700 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-500">
        </div>

        <% if @clinics.present? %>
          <div class="mt-5">
            <h2 class="text-sm font-semibold text-gray-800 mb-3 px-1">Book an Appointment</h2>
            <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-5 gap-3">
              <% @clinics.each do |clinic| %>
                <%= link_to clinic_booking_path(clinic), class: "flex flex-col items-center gap-1.5 text-center group",
                      data: { clinic_search_target: "item", clinic_search_name: clinic.name.downcase } do %>
                  <span class="w-14 h-14 rounded-2xl bg-emerald-50 group-hover:bg-emerald-100 text-emerald-600 flex items-center justify-center transition">
                    <%= render "icons/building", size: 20 %>
                  </span>
                  <span class="text-[11px] text-gray-600 leading-tight line-clamp-2"><%= clinic.name %></span>
                <% end %>
              <% end %>
            </div>
            <p data-clinic-search-target="empty" class="hidden text-center text-sm text-gray-400 py-4">No clinics found.</p>
          </div>
        <% else %>
          <p class="text-center text-sm text-gray-500 mt-5">No clinics available yet.</p>
        <% end %>
      </div>

      <div class="mt-5 lg:mt-0 lg:col-span-1">
        <h2 class="text-sm font-semibold text-gray-800 mb-3 px-1">Upcoming Appointment</h2>

        <% if @active_appointment %>
          <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-11 h-11 rounded-full bg-emerald-100 text-emerald-700 font-semibold text-sm flex items-center justify-center shrink-0">
                <%= initials_for(@active_appointment.staff) %>
              </span>
              <div class="min-w-0">
                <p class="text-sm font-semibold text-gray-900 truncate"><%= @active_appointment.staff&.display_name || "Staff — TBA" %></p>
                <p class="text-xs text-gray-500 truncate"><%= @active_appointment.service.name %></p>
              </div>
            </div>

            <div class="flex flex-col gap-1.5 text-xs text-gray-500 mb-4">
              <div class="flex items-center gap-1.5">
                <%= render "icons/calendar", size: 14, class: "shrink-0" %>
                <%= I18n.l(@active_appointment.starts_at.to_date, format: :long) %>
              </div>
              <div class="flex items-center gap-1.5">
                <%= render "icons/clock", size: 14, class: "shrink-0" %>
                <%= @active_appointment.starts_at.strftime("%I:%M %p") %>
              </div>
              <div class="flex items-center gap-1.5">
                <%= render "icons/map_pin", size: 14, class: "shrink-0" %>
                <%= @active_appointment.clinic.name %>
              </div>
            </div>

            <%= link_to "View Appointment", clinic_booking_path(@active_appointment.clinic),
                  class: "block w-full text-center bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium py-2.5 rounded-lg transition" %>
          </div>
        <% else %>
          <div class="bg-white border border-gray-200 rounded-xl p-4 text-center text-sm text-gray-500 shadow-sm">
            You don't have an upcoming appointment yet.
          </div>
        <% end %>
      </div>
    </div>

    <div class="flex items-center justify-center gap-4 pt-2 lg:hidden">
      <% if current_user.admin? %>
        <%= link_to "Admin Dashboard", admin_dashboard_path, class: "text-xs text-gray-500 hover:text-gray-700 font-medium" %>
        <span class="text-gray-300">&middot;</span>
      <% end %>
      <% if current_user.clinics.any? %>
        <%= link_to "Staff Dashboard", staff_dashboard_path, class: "text-xs text-gray-500 hover:text-gray-700 font-medium" %>
        <span class="text-gray-300">&middot;</span>
      <% end %>
      <%= button_to "Log out", destroy_user_session_path, method: :delete, data: { turbo: false },
            class: "text-xs text-gray-500 hover:text-gray-700 font-medium cursor-pointer bg-transparent" %>
    </div>
  </div>
<% else %>
  <div class="w-full max-w-5xl mx-auto flex flex-col gap-16 lg:gap-24 pb-16">
    <%# Nav %>
    <div class="w-full flex items-center justify-between pt-4">
      <span class="font-bold text-lg text-emerald-700">BookQ</span>
      <div class="flex items-center gap-4">
        <a href="#features" class="hidden sm:inline text-sm text-gray-600 hover:text-gray-900 font-medium">For Clinics</a>
        <%= link_to new_user_session_path,
              class: "flex items-center gap-1.5 text-sm font-medium text-gray-700 border border-gray-300 rounded-full pl-3 pr-4 py-1.5 hover:bg-gray-50 transition" do %>
          <%= render "icons/profile", size: 14 %>
          Log in
        <% end %>
      </div>
    </div>

    <%# Hero %>
    <div class="text-center pt-2 lg:pt-8">
      <span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 text-xs font-semibold px-3 py-1.5 rounded-full mb-5">
        <%= render "icons/calendar", size: 14 %>
        A smarter way to book
      </span>
      <h1 class="font-bold text-3xl lg:text-5xl text-gray-900 mb-4 max-w-2xl mx-auto leading-tight">
        A Smarter Way to <span class="text-emerald-600">Book Clinic Appointments</span>
      </h1>
      <p class="text-gray-500 text-sm lg:text-lg mb-8 max-w-md lg:max-w-xl mx-auto">
        Find available schedules, choose your preferred time, and book with confidence — no more waiting for a reply to "kailan available?"
      </p>

      <a href="#find-clinic"
         class="inline-flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-6 py-3 rounded-full shadow-sm transition">
        Get Started
        <%= render "icons/chevron_right", size: 16 %>
      </a>

      <p class="text-xs text-gray-500 mt-3">No account needed. Book as a guest.</p>
    </div>

    <%# Find a clinic — guest booking entry point, no account required %>
    <div id="find-clinic" data-controller="clinic-search">
      <h2 class="text-center font-bold text-2xl text-gray-900 mb-2">Find a clinic</h2>
      <p class="text-center text-gray-500 text-sm mb-6">Pick a clinic to see open slots and book instantly.</p>

      <div class="relative mb-1 max-w-md mx-auto">
        <%= render "icons/search", size: 16, class: "absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400" %>
        <input type="text" placeholder="Search clinics..." autocomplete="off"
          data-clinic-search-target="input" data-action="input->clinic-search#filter"
          class="w-full bg-white border border-gray-200 rounded-xl shadow-sm pl-10 pr-4 py-3 text-sm text-gray-700 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emerald-500">
      </div>

      <% if @clinics.present? %>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mt-6 max-w-3xl mx-auto">
          <% @clinics.each do |clinic| %>
            <%= link_to clinic_booking_path(clinic), class: "flex flex-col items-center gap-1.5 text-center group",
                  data: { clinic_search_target: "item", clinic_search_name: clinic.name.downcase } do %>
              <span class="w-14 h-14 rounded-2xl bg-emerald-50 group-hover:bg-emerald-100 text-emerald-600 flex items-center justify-center transition">
                <%= render "icons/building", size: 20 %>
              </span>
              <span class="text-xs text-gray-600 leading-tight line-clamp-2"><%= clinic.name %></span>
            <% end %>
          <% end %>
        </div>
        <p data-clinic-search-target="empty" class="hidden text-center text-sm text-gray-400 py-4">No clinics found.</p>
      <% else %>
        <p class="text-center text-sm text-gray-500 mt-5">No clinics available yet.</p>
      <% end %>
    </div>

    <%# Features %>
    <div id="features">
      <h2 class="text-center font-bold text-2xl text-gray-900 mb-8 lg:mb-10">Everything a clinic needs to manage bookings</h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
        <% [
             [ "calendar", "Real-time availability", "See each doctor's open hours and book a slot instantly — no waiting for a reply." ],
             [ "bell", "Automatic confirmations", "Patients get an email confirmation the moment a booking goes through." ],
             [ "shield_check", "No double-booking", "Every slot is checked against the doctor's schedule before it's confirmed." ],
             [ "building", "Multiple clinics", "Book across any clinic on BookQ from a single account." ]
           ].each do |icon, title, desc| %>
          <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
            <span class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center mb-3">
              <%= render "icons/#{icon}", size: 18 %>
            </span>
            <h3 class="font-semibold text-gray-900 text-sm mb-1"><%= title %></h3>
            <p class="text-gray-500 text-xs leading-relaxed"><%= desc %></p>
          </div>
        <% end %>
      </div>
    </div>

    <%# How it works %>
    <div>
      <p class="text-center text-emerald-600 text-xs font-semibold tracking-wide uppercase mb-2">How it works</p>
      <h2 class="text-center font-bold text-2xl text-gray-900 mb-8 lg:mb-10">Book in three simple steps</h2>
      <div class="relative max-w-3xl mx-auto">
        <div class="absolute top-5 sm:top-6 left-[16.67%] right-[16.67%] border-t-2 border-dashed border-emerald-200"></div>
        <div class="relative grid grid-cols-3 gap-2 sm:gap-6 lg:gap-10">
          <% [
               [ "search", "Find a clinic", "Search for the clinic you want to book with." ],
               [ "calendar", "Pick a time", "Choose a service, an optional doctor, and an open slot." ],
               [ "checkmark", "Get confirmed", "Your appointment is booked instantly — no waiting on a reply." ]
             ].each do |icon, title, desc| %>
            <div class="text-center">
              <span class="relative z-10 w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-emerald-600 text-white flex items-center justify-center mx-auto mb-3 shadow-sm">
                <%= render "icons/#{icon}", size: 18 %>
              </span>
              <h3 class="font-semibold text-gray-900 text-xs sm:text-sm mb-1"><%= title %></h3>
              <p class="text-gray-500 text-[10px] sm:text-xs leading-snug sm:leading-relaxed"><%= desc %></p>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%# Illustrated tagline banner %>
    <div class="relative bg-emerald-50 rounded-2xl px-6 py-10 lg:py-14 overflow-hidden">
      <div class="relative z-10 max-w-xs lg:max-w-sm">
        <h2 class="font-bold text-2xl text-gray-900 mb-1">Better care. Less hassle.</h2>
        <p class="text-gray-600 text-sm">Your health, on your schedule.</p>
      </div>
      <svg viewBox="0 0 240 140" class="absolute -right-2 -bottom-4 w-48 lg:w-64" aria-hidden="true">
        <ellipse cx="40" cy="28" rx="28" ry="13" fill="#ffffff" opacity="0.6" />
        <ellipse cx="95" cy="16" rx="18" ry="9" fill="#ffffff" opacity="0.5" />
        <rect x="0" y="118" width="240" height="22" fill="#a7f3d0" opacity="0.5" />
        <rect x="18" y="95" width="6" height="25" rx="1" fill="#047857" />
        <circle cx="21" cy="88" r="16" fill="#34d399" />
        <rect x="205" y="100" width="6" height="20" rx="1" fill="#047857" />
        <circle cx="208" cy="94" r="13" fill="#6ee7b7" />
        <rect x="70" y="55" width="100" height="65" rx="4" fill="#ffffff" stroke="#10b981" stroke-width="2" />
        <rect x="85" y="70" width="14" height="14" rx="2" fill="#d1fae5" />
        <rect x="113" y="70" width="14" height="14" rx="2" fill="#d1fae5" />
        <rect x="141" y="70" width="14" height="14" rx="2" fill="#d1fae5" />
        <rect x="85" y="94" width="14" height="14" rx="2" fill="#d1fae5" />
        <rect x="141" y="94" width="14" height="14" rx="2" fill="#d1fae5" />
        <rect x="110" y="90" width="20" height="30" rx="2" fill="#10b981" />
        <rect x="117" y="97" width="6" height="16" fill="#ffffff" />
        <rect x="112" y="102" width="16" height="6" fill="#ffffff" />
      </svg>
    </div>

    <%# Footer %>
    <p class="text-center text-xs text-gray-400">BookQ &middot; Better care. Less hassle.</p>
  </div>
<% end %>
