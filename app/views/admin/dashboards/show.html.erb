<div class="w-full max-w-4xl lg:max-w-6xl mx-auto bg-white rounded-xl shadow-sm border border-gray-200 p-5 sm:p-8 lg:p-10">
  <%= link_to root_path, class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 mb-4" do %>
    ← Back
  <% end %>

  <h1 class="text-2xl lg:text-3xl font-bold text-gray-900 mb-1">Admin Dashboard</h1>
  <p class="text-gray-500 text-sm lg:text-base mb-6 lg:mb-8">System-wide overview of BookQ.</p>

  <div class="grid grid-cols-3 gap-3 lg:gap-5 mb-3 lg:mb-5">
    <div class="bg-white border border-gray-200 rounded-lg lg:rounded-xl px-4 py-3 lg:px-6 lg:py-5">
      <span class="w-8 h-8 lg:w-11 lg:h-11 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2 lg:mb-3">
        <%= render "icons/building", size: 16 %>
      </span>
      <p class="text-2xl lg:text-4xl font-bold text-gray-900"><%= @clinic_count %></p>
      <p class="text-xs lg:text-sm text-gray-500">Clinics</p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg lg:rounded-xl px-4 py-3 lg:px-6 lg:py-5">
      <span class="w-8 h-8 lg:w-11 lg:h-11 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2 lg:mb-3">
        <%= render "icons/users", size: 16 %>
      </span>
      <p class="text-2xl lg:text-4xl font-bold text-gray-900"><%= @user_count %></p>
      <p class="text-xs lg:text-sm text-gray-500">Users</p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg lg:rounded-xl px-4 py-3 lg:px-6 lg:py-5">
      <span class="w-8 h-8 lg:w-11 lg:h-11 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2 lg:mb-3">
        <%= render "icons/calendar", size: 16 %>
      </span>
      <p class="text-2xl lg:text-4xl font-bold text-gray-900"><%= @total_appointments %></p>
      <p class="text-xs lg:text-sm text-gray-500">Appointments</p>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 lg:gap-5 mb-8 lg:mb-10">
    <% %w[pending confirmed cancelled completed].each do |status| %>
      <% dot_class = case status
           when "pending" then "bg-yellow-400"
           when "confirmed" then "bg-green-500"
           when "cancelled" then "bg-red-400"
           else "bg-gray-400"
         end %>
      <div class="bg-gray-50 border border-gray-200 rounded-lg lg:rounded-xl px-4 py-3 lg:px-6 lg:py-5">
        <div class="flex items-center gap-1.5 mb-1 lg:mb-2">
          <span class="w-2 h-2 rounded-full <%= dot_class %> inline-block"></span>
          <p class="text-xs lg:text-sm text-gray-500 capitalize"><%= status %></p>
        </div>
        <p class="text-2xl lg:text-3xl font-bold text-gray-900"><%= @appointment_counts[status] || 0 %></p>
      </div>
    <% end %>
  </div>

  <h2 class="text-sm lg:text-base font-semibold text-gray-700 mb-3 lg:mb-4">Recent Appointments</h2>

  <% if @recent_appointments.empty? %>
    <div class="bg-white border border-gray-200 rounded-xl p-4 text-center text-sm text-gray-500">
      No appointments yet.
    </div>
  <% else %>
    <div class="grid lg:grid-cols-2 gap-2 lg:gap-3">
      <% @recent_appointments.each do |appointment| %>
        <div class="bg-white border border-gray-200 rounded-xl p-3 lg:p-4 flex items-center gap-3">
          <span class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 font-semibold text-sm flex items-center justify-center shrink-0">
            <%= contact_initials_for(appointment) %>
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-gray-900 truncate"><%= appointment.contact_name %></p>
            <p class="text-xs text-gray-500 truncate">
              <%= appointment.clinic.name %> &middot; <%= appointment.service.name %>
            </p>
          </div>
          <div class="text-right shrink-0">
            <p class="text-xs font-medium text-gray-700"><%= I18n.l(appointment.starts_at, format: :short) %></p>
            <span class="inline-block px-2 py-0.5 rounded-full text-[11px] font-medium <%=
              case appointment.status
              when "pending" then "bg-yellow-50 text-yellow-700"
              when "confirmed" then "bg-green-50 text-green-700"
              when "cancelled" then "bg-red-50 text-red-700"
              else "bg-gray-100 text-gray-600"
              end
            %>"><%= appointment.status %></span>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
