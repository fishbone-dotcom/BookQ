<div class="w-full max-w-4xl mx-auto bg-white rounded-xl shadow-sm border border-gray-200 p-5 sm:p-8">
  <%= link_to root_path, class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 mb-4" do %>
    ← Back
  <% end %>

  <h1 class="text-2xl font-bold text-gray-900 mb-1">Admin Dashboard</h1>
  <p class="text-gray-500 text-sm mb-6">System-wide overview of BookQ.</p>

  <div class="grid grid-cols-3 gap-3 mb-3">
    <div class="bg-white border border-gray-200 rounded-lg px-4 py-3">
      <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2">
        <%= render "icons/building", size: 16 %>
      </span>
      <p class="text-2xl font-bold text-gray-900"><%= @clinic_count %></p>
      <p class="text-xs text-gray-500">Clinics</p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-4 py-3">
      <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2">
        <%= render "icons/users", size: 16 %>
      </span>
      <p class="text-2xl font-bold text-gray-900"><%= @user_count %></p>
      <p class="text-xs text-gray-500">Users</p>
    </div>
    <div class="bg-white border border-gray-200 rounded-lg px-4 py-3">
      <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2">
        <%= render "icons/calendar", size: 16 %>
      </span>
      <p class="text-2xl font-bold text-gray-900"><%= @total_appointments %></p>
      <p class="text-xs text-gray-500">Appointments</p>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8">
    <% %w[pending confirmed cancelled completed].each do |status| %>
      <% dot_class = case status
           when "pending" then "bg-yellow-400"
           when "confirmed" then "bg-green-500"
           when "cancelled" then "bg-red-400"
           else "bg-gray-400"
         end %>
      <div class="bg-gray-50 border border-gray-200 rounded-lg px-4 py-3">
        <div class="flex items-center gap-1.5 mb-1">
          <span class="w-2 h-2 rounded-full <%= dot_class %> inline-block"></span>
          <p class="text-xs text-gray-500 capitalize"><%= status %></p>
        </div>
        <p class="text-2xl font-bold text-gray-900"><%= @appointment_counts[status] || 0 %></p>
      </div>
    <% end %>
  </div>

  <h2 class="text-sm font-semibold text-gray-700 mb-3">All appointments</h2>

  <% if @appointments.empty? %>
    <p class="text-gray-500 text-sm">No appointments yet.</p>
  <% else %>
    <div class="overflow-x-auto border border-gray-200 rounded-lg">
      <table class="w-full text-sm text-left">
        <thead class="bg-gray-50 text-xs text-gray-500 uppercase">
          <tr>
            <th class="px-3 py-2">Date</th>
            <th class="px-3 py-2">Clinic</th>
            <th class="px-3 py-2">Patient</th>
            <th class="px-3 py-2">Service</th>
            <th class="px-3 py-2">Staff</th>
            <th class="px-3 py-2">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @appointments.each do |appointment| %>
            <tr>
              <td class="px-3 py-2 whitespace-nowrap"><%= I18n.l(appointment.starts_at, format: :long) %></td>
              <td class="px-3 py-2"><%= appointment.clinic.name %></td>
              <td class="px-3 py-2"><%= appointment.patient.display_name %></td>
              <td class="px-3 py-2"><%= appointment.service.name %></td>
              <td class="px-3 py-2"><%= appointment.staff&.display_name || "—" %></td>
              <td class="px-3 py-2">
                <span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium <%=
                  case appointment.status
                  when 'pending' then 'bg-yellow-50 text-yellow-700'
                  when 'confirmed' then 'bg-green-50 text-green-700'
                  when 'cancelled' then 'bg-red-50 text-red-700'
                  else 'bg-gray-100 text-gray-600'
                  end
                %>"><%= appointment.status %></span>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% if @total_pages > 1 %>
      <div class="flex items-center justify-between mt-4 text-sm">
        <% if @page > 1 %>
          <%= link_to "← Prev", admin_dashboard_path(page: @page - 1), class: "text-emerald-600 hover:underline" %>
        <% else %>
          <span></span>
        <% end %>
        <span class="text-gray-500">Page <%= @page %> of <%= @total_pages %></span>
        <% if @page < @total_pages %>
          <%= link_to "Next →", admin_dashboard_path(page: @page + 1), class: "text-emerald-600 hover:underline" %>
        <% else %>
          <span></span>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
