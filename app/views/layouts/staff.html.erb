<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Book Q" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Book Q">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen" data-controller="staff-nav">
    <%= render "staff/navigation" %>

    <div class="w-full max-w-md mx-auto flex flex-col gap-5 pb-20 px-4 pt-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <button type="button" data-action="staff-nav#open" class="text-gray-400 hover:text-gray-600">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          </button>
          <h1 class="text-lg font-bold text-gray-900"><%= content_for(:page_title) || "Dashboard" %></h1>
        </div>
        <span class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center text-gray-500">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        </span>
      </div>

      <% if notice %>
        <p class="w-full bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-2 text-sm"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="w-full bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-2 text-sm"><%= alert %></p>
      <% end %>

      <%= yield %>
    </div>

    <nav class="fixed bottom-0 inset-x-0 max-w-md mx-auto bg-white border-t border-gray-200 grid grid-cols-4 text-xs z-20">
      <%= link_to staff_dashboard_path, class: "flex flex-col items-center gap-1 py-2.5 #{current_page?(staff_dashboard_path) ? "text-emerald-700" : "text-gray-400"}" do %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5V21a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z"/></svg>
        Dashboard
      <% end %>
      <%= link_to staff_appointments_path, class: "flex flex-col items-center gap-1 py-2.5 #{current_page?(staff_appointments_path) ? "text-emerald-700" : "text-gray-400"}" do %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        Appointments
      <% end %>
      <%= link_to staff_patients_path, class: "flex flex-col items-center gap-1 py-2.5 #{current_page?(staff_patients_path) ? "text-emerald-700" : "text-gray-400"}" do %>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Patients
      <% end %>
      <button type="button" data-action="staff-nav#open" class="flex flex-col items-center gap-1 py-2.5 text-gray-400 hover:text-gray-600 cursor-pointer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
        More
      </button>
    </nav>
  </body>
</html>
