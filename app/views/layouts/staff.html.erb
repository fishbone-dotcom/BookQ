<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Book Q" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Book Q">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen" data-controller="staff-nav">
    <%= render "staff/navigation" %>

    <div class="w-full max-w-md mx-auto flex flex-col gap-5 <%= content_for?(:back_path) ? "pb-6" : "pb-20" %> px-4 pt-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <% if content_for?(:back_path) %>
            <%= link_to content_for(:back_path), class: "text-gray-400 hover:text-gray-600" do %>
              <%= render "icons/back_arrow" %>
            <% end %>
          <% else %>
            <button type="button" data-action="staff-nav#open" class="text-gray-400 hover:text-gray-600">
              <%= render "icons/hamburger" %>
            </button>
          <% end %>
          <h1 class="text-lg font-bold text-gray-900"><%= content_for(:page_title) || "Dashboard" %></h1>
        </div>
        <% if content_for?(:header_action) %>
          <%= content_for(:header_action) %>
        <% else %>
          <span class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center text-gray-500">
            <%= render "icons/bell", size: 17 %>
          </span>
        <% end %>
      </div>

      <% if notice %>
        <p class="w-full bg-green-50 border border-green-200 text-green-700 rounded-lg px-4 py-2 text-sm"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="w-full bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-2 text-sm"><%= alert %></p>
      <% end %>

      <%= yield %>
    </div>

    <% unless content_for?(:back_path) %>
      <nav class="fixed bottom-0 inset-x-0 max-w-md mx-auto bg-white border-t border-gray-200 grid grid-cols-4 text-xs z-20">
        <%= link_to staff_dashboard_path, class: "flex flex-col items-center gap-1 py-2.5 #{current_page?(staff_dashboard_path) ? "text-emerald-700" : "text-gray-400"}" do %>
          <%= render "icons/dashboard", size: 18 %>
          Dashboard
        <% end %>
        <%= link_to staff_appointments_path, class: "flex flex-col items-center gap-1 py-2.5 #{current_page?(staff_appointments_path) ? "text-emerald-700" : "text-gray-400"}" do %>
          <%= render "icons/calendar", size: 18 %>
          Appointments
        <% end %>
        <%= link_to staff_patients_path, class: "flex flex-col items-center gap-1 py-2.5 #{current_page?(staff_patients_path) ? "text-emerald-700" : "text-gray-400"}" do %>
          <%= render "icons/users", size: 18 %>
          Patients
        <% end %>
        <button type="button" data-action="staff-nav#open" class="flex flex-col items-center gap-1 py-2.5 text-gray-400 hover:text-gray-600 cursor-pointer">
          <%= render "icons/dots_more", size: 18 %>
          More
        </button>
      </nav>
    <% end %>
  </body>
</html>
