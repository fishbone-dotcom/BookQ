<div data-staff-nav-target="overlay" data-action="click->staff-nav#close" class="hidden fixed inset-0 bg-gray-900/40 z-30"></div>

<aside data-staff-nav-target="panel" class="fixed inset-y-0 left-0 z-40 w-72 max-w-[85vw] bg-white -translate-x-full transition-transform duration-200 flex flex-col shadow-xl">
  <div class="h-14 flex items-center justify-between px-4 border-b border-gray-100 shrink-0">
    <span class="font-bold text-lg text-gray-900">Menu</span>
    <button type="button" data-action="staff-nav#close" class="text-gray-400 hover:text-gray-600">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
    <%= link_to staff_dashboard_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium #{current_page?(staff_dashboard_path) ? "bg-emerald-50 text-emerald-700" : "text-gray-700 hover:bg-gray-50"}" do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M3 9.5 12 3l9 6.5V21a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z"/></svg>
      Dashboard
    <% end %>

    <%= link_to staff_appointments_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium #{current_page?(staff_appointments_path) ? "bg-emerald-50 text-emerald-700" : "text-gray-700 hover:bg-gray-50"}" do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      Appointments
    <% end %>

    <%= link_to staff_doctors_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium #{current_page?(staff_doctors_path) ? "bg-emerald-50 text-emerald-700" : "text-gray-700 hover:bg-gray-50"}" do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect x="2" y="4" width="20" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M15 8h2M15 12h2M7 16h10"/></svg>
      Doctors
    <% end %>

    <%= link_to staff_patients_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium #{current_page?(staff_patients_path) ? "bg-emerald-50 text-emerald-700" : "text-gray-700 hover:bg-gray-50"}" do %>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Patients
    <% end %>

    <% [
      [ "Patient Records", '<path d="M9 2h6a1 1 0 0 1 1 1v1h1a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1V3a1 1 0 0 1 1-1Z"/><path d="M9 12h6M9 16h6"/>' ],
      [ "Billing & Payments", '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>' ],
      [ "Inventory", '<path d="M21 8 12 3 3 8l9 5 9-5Z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/>' ],
      [ "Reports", '<path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12" y="8" width="3" height="10"/><rect x="17" y="5" width="3" height="13"/>' ],
      [ "Notifications", '<path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/>' ],
      [ "Settings", '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/>' ],
    ].each do |label, icon| %>
      <span class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-400" title="Coming soon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><%= icon.html_safe %></svg>
        <span class="flex-1"><%= label %></span>
        <span class="text-[10px] bg-gray-100 text-gray-400 px-1.5 py-0.5 rounded-full">Soon</span>
      </span>
    <% end %>
  </nav>

  <div class="border-t border-gray-100 px-3 py-3 shrink-0">
    <% if current_user.clinics.count > 1 %>
      <div class="mb-3">
        <p class="text-[11px] uppercase text-gray-400 font-medium px-2 mb-1">Clinic</p>
        <% current_user.clinics.each do |clinic| %>
          <%= link_to staff_active_clinic_path(clinic_id: clinic.id), data: { turbo_method: :patch },
                class: "flex items-center justify-between px-2 py-1.5 rounded-lg text-sm #{clinic == @clinic ? "bg-emerald-50 text-emerald-700 font-medium" : "text-gray-600 hover:bg-gray-50"}" do %>
            <%= clinic.name %>
            <% if clinic == @clinic %>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="px-2 text-sm text-gray-600 font-medium mb-3"><%= @clinic&.name %></p>
    <% end %>

    <div class="flex items-center gap-2 px-2 mb-2">
      <span class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 font-semibold text-xs flex items-center justify-center shrink-0">
        <%= initials_for(current_user) %>
      </span>
      <div class="min-w-0">
        <p class="text-sm font-medium text-gray-900 truncate"><%= current_user.display_name %></p>
        <p class="text-xs text-gray-500 truncate"><%= @clinic_staff&.owner? ? "Clinic Owner" : "Staff" %></p>
      </div>
    </div>

    <%= button_to "Log out", destroy_user_session_path, method: :delete, data: { turbo: false },
          class: "w-full text-left px-2 py-1.5 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-50 hover:text-gray-700 cursor-pointer transition" %>
  </div>
</aside>
