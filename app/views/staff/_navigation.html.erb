<div data-staff-nav-target="overlay" data-action="click->staff-nav#close" class="hidden fixed inset-0 bg-gray-900/40 z-30"></div>

<aside data-staff-nav-target="panel" class="fixed inset-y-0 left-0 z-40 w-72 max-w-[85vw] bg-white -translate-x-full transition-transform duration-200 flex flex-col shadow-xl">
  <div class="h-14 flex items-center justify-between px-4 border-b border-gray-100 shrink-0">
    <span class="font-bold text-lg text-gray-900">Menu</span>
    <button type="button" data-action="staff-nav#close" class="text-gray-400 hover:text-gray-600">
      <%= render "icons/close", size: 20 %>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
    <%= link_to staff_dashboard_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium #{current_page?(staff_dashboard_path) ? "bg-emerald-50 text-emerald-700" : "text-gray-700 hover:bg-gray-50"}" do %>
      <%= render "icons/dashboard", size: 18, class: "shrink-0" %>
      Dashboard
    <% end %>

    <%= link_to staff_appointments_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium #{current_page?(staff_appointments_path) ? "bg-emerald-50 text-emerald-700" : "text-gray-700 hover:bg-gray-50"}" do %>
      <%= render "icons/calendar", size: 18, class: "shrink-0" %>
      Appointments
    <% end %>

    <%= link_to staff_doctors_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium #{current_page?(staff_doctors_path) ? "bg-emerald-50 text-emerald-700" : "text-gray-700 hover:bg-gray-50"}" do %>
      <%= render "icons/doctors", size: 18, class: "shrink-0" %>
      Doctors
    <% end %>

    <%= link_to staff_patients_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium #{current_page?(staff_patients_path) ? "bg-emerald-50 text-emerald-700" : "text-gray-700 hover:bg-gray-50"}" do %>
      <%= render "icons/users", size: 18, class: "shrink-0" %>
      Patients
    <% end %>

    <%= link_to staff_reports_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium #{current_page?(staff_reports_path) ? "bg-emerald-50 text-emerald-700" : "text-gray-700 hover:bg-gray-50"}" do %>
      <%= render "icons/reports", size: 18, class: "shrink-0" %>
      Reports
    <% end %>

    <%= link_to staff_settings_path, class: "flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium #{current_page?(staff_settings_path) ? "bg-emerald-50 text-emerald-700" : "text-gray-700 hover:bg-gray-50"}" do %>
      <%= render "icons/settings", size: 18, class: "shrink-0" %>
      Settings
    <% end %>

    <% [
      [ "Patient Records", "patient_records" ],
      [ "Billing & Payments", "billing" ],
      [ "Inventory", "inventory" ],
      [ "Notifications", "bell" ],
    ].each do |label, icon| %>
      <span class="flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-400" title="Coming soon">
        <%= render "icons/#{icon}", size: 18, class: "shrink-0" %>
        <span class="flex-1"><%= label %></span>
        <span class="text-[10px] bg-gray-100 text-gray-400 px-1.5 py-0.5 rounded-full">Soon</span>
      </span>
    <% end %>
  </nav>

  <div class="border-t border-gray-100 px-3 py-3 shrink-0">
    <% if current_user.clinics.count > 1 %>
      <div class="mb-3">
        <p class="text-[11px] uppercase text-gray-400 font-medium px-2 mb-1">Clinic</p>
        <% current_user.clinics.each do |clinic| %>
          <%= link_to staff_active_clinic_path(clinic_id: clinic.id), data: { turbo_method: :patch },
                class: "flex items-center justify-between px-2 py-1.5 rounded-lg text-sm #{clinic == @clinic ? "bg-emerald-50 text-emerald-700 font-medium" : "text-gray-600 hover:bg-gray-50"}" do %>
            <%= clinic.name %>
            <% if clinic == @clinic %>
              <%= render "icons/checkmark", size: 14 %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="px-2 text-sm text-gray-600 font-medium mb-3"><%= @clinic&.name %></p>
    <% end %>

    <div class="flex items-center gap-2 px-2 mb-2">
      <span class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 font-semibold text-xs flex items-center justify-center shrink-0">
        <%= initials_for(current_user) %>
      </span>
      <div class="min-w-0">
        <p class="text-sm font-medium text-gray-900 truncate"><%= current_user.display_name %></p>
        <p class="text-xs text-gray-500 truncate"><%= @clinic_staff&.owner? ? "Clinic Owner" : "Staff" %></p>
      </div>
    </div>

    <%= button_to "Log out", destroy_user_session_path, method: :delete, data: { turbo: false },
          class: "w-full text-left px-2 py-1.5 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-50 hover:text-gray-700 cursor-pointer transition" %>
  </div>
</aside>
