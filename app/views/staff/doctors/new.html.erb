<% content_for(:page_title, "Add Doctor") %>
<% content_for(:back_path, staff_doctors_path) %>

<%= form_with url: staff_doctors_path, method: :post, class: "flex flex-col gap-5" do %>
  <div class="flex justify-center">
    <span class="w-20 h-20 rounded-full bg-gray-100 flex items-center justify-center text-gray-400">
      <%= render "icons/camera", size: 24 %>
    </span>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Full Name</label>
    <input type="text" name="name" value="<%= params[:name] %>" required placeholder="Enter full name"
      class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Specialization</label>
    <input type="text" name="specialization" value="<%= params[:specialization] %>" placeholder="e.g. Pediatrician"
      class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
    <input type="email" name="email" value="<%= params[:email] %>" required placeholder="Enter email address"
      class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
    <p class="text-xs text-gray-500 mt-1">If this email already has a BookQ account, they'll just be added to this clinic.</p>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Phone Number</label>
    <input type="tel" name="phone" value="<%= params[:phone] %>" placeholder="Enter phone number"
      class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Status</label>
    <div class="grid grid-cols-2 gap-2">
      <label class="relative flex items-center justify-center border border-gray-200 rounded-xl py-2.5 text-sm font-medium text-gray-700 cursor-pointer shadow-sm has-checked:border-emerald-600 has-checked:bg-emerald-600 has-checked:text-white transition">
        <input type="radio" name="status" value="available" class="sr-only" <%= "checked" if params[:status].blank? || params[:status] == "available" %>>
        Available
      </label>
      <label class="relative flex items-center justify-center border border-gray-200 rounded-xl py-2.5 text-sm font-medium text-gray-700 cursor-pointer shadow-sm has-checked:border-emerald-600 has-checked:bg-emerald-600 has-checked:text-white transition">
        <input type="radio" name="status" value="on_leave" class="sr-only" <%= "checked" if params[:status] == "on_leave" %>>
        On Leave
      </label>
    </div>
  </div>

  <%= submit_tag "Save Doctor", class: "w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-xl cursor-pointer transition" %>
<% end %>
