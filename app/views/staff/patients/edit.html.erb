<% content_for(:page_title, "Edit Patient Profile") %>
<% content_for(:back_path, staff_patient_path(@patient)) %>

<div class="flex items-center gap-3 bg-white border border-gray-200 rounded-xl p-3 shadow-sm mb-5">
  <span class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center text-sm font-semibold flex-none"><%= initials_for(@patient) %></span>
  <div class="min-w-0 flex-1">
    <p class="text-sm font-semibold text-gray-900 truncate"><%= @patient.display_name %></p>
    <p class="text-xs text-gray-500 truncate"><%= @patient.email %></p>
  </div>
</div>

<%= form_with model: @profile, url: staff_patient_path(@patient), method: :patch, class: "flex flex-col gap-5" do |f| %>
  <% if @profile.errors.any? %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-2 text-sm">
      <%= @profile.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <%= render "shared/form_field", form: f, attribute: :birthdate, label: "Birthdate", type: :date,
        html_options: { max: Date.current.iso8601 } %>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Sex</label>
    <div class="grid grid-cols-3 gap-2">
      <% [ "Male", "Female", "Other" ].each do |option| %>
        <label class="relative flex items-center justify-center border border-gray-200 rounded-xl py-2.5 text-sm font-medium text-gray-700 cursor-pointer shadow-sm has-checked:border-emerald-600 has-checked:bg-emerald-600 has-checked:text-white transition">
          <%= f.radio_button :sex, option, class: "sr-only" %>
          <%= option %>
        </label>
      <% end %>
    </div>
  </div>

  <%= render "shared/form_field", form: f, attribute: :phone, label: "Phone", placeholder: "Enter phone number" %>

  <%= render "shared/form_field", form: f, attribute: :address, label: "Address", placeholder: "Enter address" %>

  <%= render "shared/form_field", form: f, attribute: :blood_type, label: "Blood Type", placeholder: "e.g. O+" %>

  <%= render "shared/form_field", form: f, attribute: :allergies, label: "Allergies", type: :textarea, rows: 2, placeholder: "e.g. None" %>

  <div class="border-t border-gray-100 pt-4">
    <h3 class="text-xs font-medium text-gray-500 uppercase mb-3">Emergency Contact</h3>
    <div class="flex flex-col gap-3">
      <%= f.text_field :emergency_contact_name, placeholder: "Contact name",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" %>
      <%= f.text_field :emergency_contact_relationship, placeholder: "Relationship (e.g. Mother)",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" %>
      <%= f.text_field :emergency_contact_phone, placeholder: "Contact phone",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500" %>
    </div>
  </div>

  <%= f.submit "Save Changes", class: "w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-xl cursor-pointer transition" %>
<% end %>
