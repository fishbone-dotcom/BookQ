<div class="w-full max-w-md mx-auto flex flex-col gap-5 pb-20">
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="text-gray-400">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </span>
      <h1 class="text-lg font-bold text-gray-900">Dashboard</h1>
    </div>
    <span class="w-9 h-9 rounded-full bg-gray-100 flex items-center justify-center text-gray-500">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
    </span>
  </div>

  <div>
    <p class="text-lg font-semibold text-gray-900"><%= time_of_day_greeting %>, <%= current_user.display_name %> 👋</p>
    <p class="text-sm text-gray-500">Here's what's happening in your clinic today.</p>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <div class="bg-white border border-gray-200 rounded-xl px-4 py-3">
      <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
      </span>
      <p class="text-2xl font-bold text-gray-900"><%= @today_appointments_count %></p>
      <p class="text-xs text-gray-500">Today's Appointments</p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl px-4 py-3">
      <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
      <p class="text-2xl font-bold text-gray-900"><%= @total_patients_count %></p>
      <p class="text-xs text-gray-500">Total Patients</p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl px-4 py-3">
      <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M15 8h2M15 12h2M7 16h10"/></svg>
      </span>
      <p class="text-2xl font-bold text-gray-900"><%= @doctors_count %></p>
      <p class="text-xs text-gray-500">Doctors</p>
    </div>
    <div class="bg-white border border-gray-200 rounded-xl px-4 py-3">
      <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center mb-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><path d="M20 8v6M23 11h-6"/></svg>
      </span>
      <p class="text-2xl font-bold text-gray-900"><%= @new_patients_this_month_count %></p>
      <p class="text-xs text-gray-500">New Patients (This Month)</p>
    </div>
  </div>

  <div>
    <h2 class="text-sm font-semibold text-gray-800 mb-3">Recent Appointments</h2>

    <% if @recent_appointments.empty? %>
      <div class="bg-white border border-gray-200 rounded-xl p-4 text-center text-sm text-gray-500 shadow-sm">
        No upcoming appointments.
      </div>
    <% else %>
      <div class="flex flex-col gap-2">
        <% @recent_appointments.each do |appointment| %>
          <div class="bg-white border border-gray-200 rounded-xl p-3 flex items-center gap-3 shadow-sm">
            <span class="w-10 h-10 rounded-full bg-emerald-100 text-emerald-700 font-semibold text-sm flex items-center justify-center shrink-0">
              <%= initials_for(appointment.patient) %>
            </span>
            <div class="min-w-0 flex-1">
              <p class="text-sm font-semibold text-gray-900 truncate"><%= appointment.patient.display_name %></p>
              <p class="text-xs text-gray-500 truncate">
                <%= appointment.service.name %>
                <% if appointment.staff %> &middot; <%= appointment.staff.display_name %><% end %>
              </p>
            </div>
            <div class="text-right shrink-0">
              <p class="text-xs font-medium text-gray-700"><%= appointment.starts_at.strftime("%I:%M %p") %></p>
              <span class="inline-block px-2 py-0.5 rounded-full text-[11px] font-medium <%=
                case appointment.status
                when "pending" then "bg-yellow-50 text-yellow-700"
                when "confirmed" then "bg-green-50 text-green-700"
                when "cancelled" then "bg-red-50 text-red-700"
                else "bg-gray-100 text-gray-600"
                end
              %>"><%= appointment.status %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<nav class="fixed bottom-0 inset-x-0 bg-white border-t border-gray-200 grid grid-cols-4 text-xs z-20">
  <%= link_to staff_dashboard_path, class: "flex flex-col items-center gap-1 py-2.5 text-emerald-700" do %>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5V21a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z"/></svg>
    Dashboard
  <% end %>
  <span class="flex flex-col items-center gap-1 py-2.5 text-gray-300">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
    Appointments
  </span>
  <span class="flex flex-col items-center gap-1 py-2.5 text-gray-300">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    Patients
  </span>
  <span class="flex flex-col items-center gap-1 py-2.5 text-gray-300">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
    More
  </span>
</nav>
