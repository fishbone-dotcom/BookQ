<% content_for(:page_title, "Settings") %>

<% is_owner = @clinic_staff&.owner? %>

<h2 class="text-xs font-medium text-gray-500 uppercase mb-2">Clinic Settings</h2>
<div class="bg-white border border-gray-200 rounded-xl shadow-sm divide-y divide-gray-100 mb-5">
  <% [
    [ "Clinic Information", staff_edit_clinic_settings_path, '<path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/>' ],
    [ "Working Hours", staff_availabilities_path, '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>' ],
  ].each do |label, path, icon| %>
    <% if is_owner %>
      <%= link_to path, class: "flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition" do %>
        <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center flex-none">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= icon.html_safe %></svg>
        </span>
        <span class="flex-1 text-sm font-medium text-gray-900"><%= label %></span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300"><path d="m9 18 6-6-6-6"/></svg>
      <% end %>
    <% else %>
      <div class="flex items-center gap-3 px-4 py-3" title="Only clinic owners can edit this">
        <span class="w-8 h-8 rounded-full bg-gray-100 text-gray-300 flex items-center justify-center flex-none">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= icon.html_safe %></svg>
        </span>
        <span class="flex-1 text-sm font-medium text-gray-400"><%= label %></span>
        <span class="text-[10px] bg-gray-100 text-gray-400 px-1.5 py-0.5 rounded-full">Owner only</span>
      </div>
    <% end %>
  <% end %>
</div>

<h2 class="text-xs font-medium text-gray-500 uppercase mb-2">System</h2>
<div class="bg-white border border-gray-200 rounded-xl shadow-sm divide-y divide-gray-100 mb-5">
  <% if is_owner %>
    <%= link_to staff_clinic_staffs_path, class: "flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition" do %>
      <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center flex-none">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
      <span class="flex-1 text-sm font-medium text-gray-900">Users &amp; Roles</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300"><path d="m9 18 6-6-6-6"/></svg>
    <% end %>
  <% else %>
    <div class="flex items-center gap-3 px-4 py-3" title="Only clinic owners can manage staff">
      <span class="w-8 h-8 rounded-full bg-gray-100 text-gray-300 flex items-center justify-center flex-none">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      </span>
      <span class="flex-1 text-sm font-medium text-gray-400">Users &amp; Roles</span>
      <span class="text-[10px] bg-gray-100 text-gray-400 px-1.5 py-0.5 rounded-full">Owner only</span>
    </div>
  <% end %>
</div>

<h2 class="text-xs font-medium text-gray-500 uppercase mb-2">Account</h2>
<div class="bg-white border border-gray-200 rounded-xl shadow-sm divide-y divide-gray-100">
  <% [
    [ "Profile", edit_user_registration_path, '<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>' ],
    [ "Change Password", edit_user_registration_path, '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>' ],
  ].each do |label, path, icon| %>
    <%= link_to path, class: "flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition" do %>
      <span class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center flex-none">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= icon.html_safe %></svg>
      </span>
      <span class="flex-1 text-sm font-medium text-gray-900"><%= label %></span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-300"><path d="m9 18 6-6-6-6"/></svg>
    <% end %>
  <% end %>
  <%= button_to destroy_user_session_path, method: :delete, data: { turbo: false },
        class: "w-full flex items-center gap-3 px-4 py-3 hover:bg-gray-50 transition cursor-pointer text-left" do %>
    <span class="w-8 h-8 rounded-full bg-red-50 text-red-600 flex items-center justify-center flex-none">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
    </span>
    <span class="flex-1 text-sm font-medium text-red-600">Logout</span>
  <% end %>
</div>
