<% content_for(:page_title, "Calendar View") %>

<%= render "staff/day_strip", date: @date, week_start: @week_start, week_days: @week_days,
      path_for: ->(d) { staff_calendar_path(date: d.iso8601) } %>

<%= render "staff/view_toggle", date: @date, active: "calendar" %>

<% if @availability.nil? %>
  <div class="bg-white border border-gray-200 rounded-xl p-4 text-center text-sm text-gray-500 shadow-sm">
    Clinic is closed on <%= @date.strftime("%A") %>.
  </div>
<% else %>
  <%
    start_minutes = @availability.start_time.hour * 60 + @availability.start_time.min
    end_minutes = @availability.end_time.hour * 60 + @availability.end_time.min
    total_minutes = end_minutes - start_minutes
    px_per_min = 1.2
    grid_height = total_minutes * px_per_min
    hour_marks = ((start_minutes.to_f / 60).ceil..(end_minutes.to_f / 60).floor)
  %>

  <div class="flex border border-gray-200 rounded-xl bg-white overflow-hidden">
    <!-- Time column -->
    <div class="w-12 shrink-0 border-r border-gray-100 relative" style="height: <%= grid_height %>px;">
      <% hour_marks.each do |hour| %>
        <span class="absolute inset-x-0 text-center text-[10px] text-gray-400 pt-0.5" style="top: <%= (hour * 60 - start_minutes) * px_per_min %>px;">
          <%= Time.zone.parse("#{hour}:00").strftime("%-I %p") %>
        </span>
      <% end %>
    </div>

    <!-- Appointments column -->
    <div class="flex-1 relative" style="height: <%= grid_height %>px;">
      <% hour_marks.each do |hour| %>
        <div class="absolute inset-x-0 border-t border-gray-100" style="top: <%= (hour * 60 - start_minutes) * px_per_min %>px;"></div>
      <% end %>

      <div class="absolute inset-y-0 inset-x-1">
        <% @placements.each do |placement| %>
          <% appointment = placement.appointment
             start_offset = ((appointment.starts_at.hour * 60 + appointment.starts_at.min) - start_minutes) * px_per_min
             duration_min = (appointment.ends_at - appointment.starts_at) / 60.0
             block_height = [ duration_min * px_per_min, 22 ].max
             width_pct = 100.0 / placement.columns
             left_pct = placement.column * width_pct
             color_class = case appointment.status
               when "pending" then "bg-yellow-100 border-yellow-300 text-yellow-800"
               when "confirmed" then "bg-emerald-100 border-emerald-400 text-emerald-800"
               else "bg-gray-100 border-gray-300 text-gray-700"
               end %>
          <%= link_to edit_staff_appointment_path(appointment, date: @date.iso8601),
                class: "absolute rounded-md border px-1.5 py-0.5 overflow-hidden flex items-center hover:brightness-95 transition #{color_class}",
                style: "top: #{start_offset}px; height: #{block_height}px; left: #{left_pct}%; width: calc(#{width_pct}% - 4px);" do %>
            <p class="text-[9px] font-semibold truncate leading-tight">
              <%= appointment.patient.display_name %> | <%= appointment.service.name %>
            </p>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="fixed inset-x-0 bottom-24 z-10 pointer-events-none">
  <div class="max-w-md mx-auto relative px-4">
    <%= link_to new_staff_appointment_path(date: @date.iso8601), class: "absolute right-4 bottom-0 w-12 h-12 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center shadow-lg transition pointer-events-auto" do %>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
    <% end %>
  </div>
</div>
