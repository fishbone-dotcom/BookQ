<% content_for(:page_title, "Patient Report") %>
<% content_for(:back_path, staff_reports_path) %>

<%= render "staff/reports/period_filter", current_period: @period, path_for: ->(period) { staff_reports_patients_path(period: period) } %>

<div class="grid grid-cols-2 gap-3 mb-4">
  <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
    <p class="text-xs text-gray-500 mb-1">New Patients</p>
    <p class="text-2xl font-bold text-gray-900"><%= @new_count %></p>
  </div>
  <div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
    <p class="text-xs text-gray-500 mb-1">Returning Patients</p>
    <p class="text-2xl font-bold text-gray-900"><%= @returning_count %></p>
  </div>
</div>

<div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm">
  <p class="text-xs text-gray-500 mb-1">Total Patients Seen</p>
  <p class="text-3xl font-bold text-gray-900"><%= @total_patients %></p>
</div>
