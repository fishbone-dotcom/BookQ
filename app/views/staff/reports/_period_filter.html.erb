<div class="flex gap-2 overflow-x-auto mb-4">
  <% Staff::ReportsController::PERIODS.each do |period| %>
    <%= link_to Staff::ReportsController::PERIOD_LABELS[period], path_for.call(period),
          class: "px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap #{current_period == period ? "bg-emerald-600 text-white" : "bg-gray-100 text-gray-600 hover:bg-gray-200"}" %>
  <% end %>
</div>
