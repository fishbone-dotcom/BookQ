<% content_for(:page_title, "Reports") %>

<div class="grid grid-cols-2 gap-3">
  <% reports = [
    { label: "Appointments Report", path: staff_reports_appointments_path, icon: "calendar" },
    { label: "Patient Report", path: staff_reports_patients_path, icon: "users" },
    { label: "Services Report", path: staff_reports_services_path, icon: "pill" },
    { label: "Doctors Performance", path: nil, icon: "doctors" },
    { label: "Revenue Report", path: nil, icon: "dollar_wave" },
    { label: "Inventory Report", path: nil, icon: "inventory" },
  ] %>
  <% reports.each do |report| %>
    <% if report[:path] %>
      <%= link_to report[:path], class: "flex flex-col gap-3 bg-white border border-gray-200 rounded-xl p-4 shadow-sm hover:border-emerald-300 transition" do %>
        <span class="w-9 h-9 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center flex-none">
          <%= render "icons/#{report[:icon]}", size: 16 %>
        </span>
        <span class="text-sm font-medium text-gray-900"><%= report[:label] %></span>
      <% end %>
    <% else %>
      <div class="flex flex-col gap-3 bg-gray-50 border border-gray-200 rounded-xl p-4" title="Coming soon">
        <span class="w-9 h-9 rounded-full bg-gray-100 text-gray-300 flex items-center justify-center flex-none">
          <%= render "icons/#{report[:icon]}", size: 16 %>
        </span>
        <span class="flex items-center justify-between gap-2">
          <span class="text-sm font-medium text-gray-400"><%= report[:label] %></span>
          <span class="text-[10px] bg-gray-100 text-gray-400 px-1.5 py-0.5 rounded-full shrink-0">Soon</span>
        </span>
      </div>
    <% end %>
  <% end %>
</div>
