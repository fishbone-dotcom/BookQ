<% content_for(:page_title, "Reports") %>

<div class="grid grid-cols-2 gap-3">
  <% reports = [
    { label: "Appointments Report", path: staff_reports_appointments_path,
      icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>' },
    { label: "Patient Report", path: staff_reports_patients_path,
      icon: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
    { label: "Services Report", path: staff_reports_services_path,
      icon: '<path d="M11 2a2 2 0 0 0-2 2v5a5 5 0 0 0 10 0V4a2 2 0 0 0-2-2"/><path d="M8 15v1a6 6 0 0 0 12 0v-3"/><circle cx="20" cy="10" r="2"/>' },
    { label: "Doctors Performance", path: nil,
      icon: '<rect x="2" y="4" width="20" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M15 8h2M15 12h2M7 16h10"/>' },
    { label: "Revenue Report", path: nil,
      icon: '<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>' },
    { label: "Inventory Report", path: nil,
      icon: '<path d="M21 8 12 3 3 8l9 5 9-5Z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/>' },
  ] %>
  <% reports.each do |report| %>
    <% if report[:path] %>
      <%= link_to report[:path], class: "flex flex-col gap-3 bg-white border border-gray-200 rounded-xl p-4 shadow-sm hover:border-emerald-300 transition" do %>
        <span class="w-9 h-9 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center flex-none">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= report[:icon].html_safe %></svg>
        </span>
        <span class="text-sm font-medium text-gray-900"><%= report[:label] %></span>
      <% end %>
    <% else %>
      <div class="flex flex-col gap-3 bg-gray-50 border border-gray-200 rounded-xl p-4" title="Coming soon">
        <span class="w-9 h-9 rounded-full bg-gray-100 text-gray-300 flex items-center justify-center flex-none">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%= report[:icon].html_safe %></svg>
        </span>
        <span class="flex items-center justify-between gap-2">
          <span class="text-sm font-medium text-gray-400"><%= report[:label] %></span>
          <span class="text-[10px] bg-gray-100 text-gray-400 px-1.5 py-0.5 rounded-full shrink-0">Soon</span>
        </span>
      </div>
    <% end %>
  <% end %>
</div>
