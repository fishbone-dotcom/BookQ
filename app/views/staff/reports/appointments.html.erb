<% content_for(:page_title, "Appointments Report") %>

<%= link_to staff_reports_path, class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 -mt-1 mb-4" do %>
  ← Back
<% end %>

<%= render "staff/reports/period_filter", current_period: @period, path_for: ->(period) { staff_reports_appointments_path(period: period) } %>

<div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm mb-4">
  <p class="text-xs text-gray-500 mb-1">Total Appointments</p>
  <p class="text-3xl font-bold text-gray-900"><%= @total %></p>
</div>

<div class="bg-white border border-gray-200 rounded-xl p-4 shadow-sm flex flex-col gap-3">
  <h2 class="text-sm font-semibold text-gray-900">By Status</h2>
  <% @by_status.each do |status, count| %>
    <% pct = @total.zero? ? 0 : (count * 100.0 / @total).round %>
    <div>
      <div class="flex justify-between text-sm mb-1">
        <span class="text-gray-700 capitalize"><%= status %></span>
        <span class="text-gray-500"><%= count %> (<%= pct %>%)</span>
      </div>
      <div class="w-full bg-gray-100 rounded-full h-2">
        <div class="<%=
          case status
          when "pending" then "bg-yellow-400"
          when "confirmed" then "bg-green-500"
          when "completed" then "bg-emerald-600"
          else "bg-red-400"
          end
        %> h-2 rounded-full" style="width: <%= pct %>%;"></div>
      </div>
    </div>
  <% end %>
</div>
