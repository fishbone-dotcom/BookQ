<% content_for(:page_title, "Appointments") %>

<%= render "staff/day_strip", date: @date, week_start: @week_start, week_days: @week_days,
      path_for: ->(d) { staff_appointments_path(date: d.iso8601, status: @status) } %>

<%= render "staff/view_toggle", date: @date, active: "list" %>

<div class="flex items-center justify-between mb-3">
  <div class="flex gap-2 overflow-x-auto">
    <% Staff::AppointmentsController::STATUSES.each do |status| %>
      <%= link_to status.capitalize, staff_appointments_path(date: @date.iso8601, status: status),
            class: "px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap #{@status == status ? "bg-emerald-600 text-white" : "bg-gray-100 text-gray-600 hover:bg-gray-200"}" %>
    <% end %>
  </div>
  <%= link_to new_staff_appointment_path(date: @date.iso8601), class: "w-8 h-8 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white flex items-center justify-center shrink-0 ml-2 transition" do %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
  <% end %>
</div>

<% if @appointments.empty? %>
  <div class="bg-white border border-gray-200 rounded-xl p-4 text-center text-sm text-gray-500 shadow-sm">
    No appointments for this day.
  </div>
<% else %>
  <div class="flex flex-col gap-2">
    <% @appointments.each do |appointment| %>
      <div class="bg-white border border-gray-200 rounded-xl p-3 flex items-center gap-3 shadow-sm">
        <div class="text-xs font-semibold text-gray-700 w-16 shrink-0"><%= appointment.starts_at.strftime("%I:%M %p") %></div>
        <div class="min-w-0 flex-1">
          <p class="text-sm font-semibold text-gray-900 truncate"><%= appointment.patient.display_name %></p>
          <p class="text-xs text-gray-500 truncate">
            <%= appointment.service.name %>
            <% if appointment.staff %> &middot; <%= appointment.staff.display_name %><% end %>
          </p>
        </div>
        <span class="inline-block px-2 py-0.5 rounded-full text-[11px] font-medium shrink-0 <%=
          case appointment.status
          when "pending" then "bg-yellow-50 text-yellow-700"
          when "confirmed" then "bg-green-50 text-green-700"
          when "cancelled" then "bg-red-50 text-red-700"
          else "bg-gray-100 text-gray-600"
          end
        %>"><%= appointment.status %></span>
      </div>
    <% end %>
  </div>
<% end %>
