<% content_for(:page_title, "Add Appointment") %>
<% content_for(:back_path, staff_appointments_path(date: @date&.iso8601)) %>

<%= form_with url: new_staff_appointment_path, method: :get, data: { controller: "auto-submit" }, class: "flex flex-col gap-5" do %>
  <%= hidden_field_tag :patient_id, @patient_id %>
  <%= hidden_field_tag :staff_id, @staff_id %>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Service</label>
    <% if @services.empty? %>
      <p class="text-sm text-gray-500">This clinic doesn't have any services yet.</p>
    <% else %>
      <div class="flex flex-col gap-2">
        <% @services.each do |service| %>
          <label class="group relative flex items-center gap-3 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer shadow-sm has-checked:border-emerald-600 has-checked:bg-emerald-50 transition">
            <input type="radio" name="service_id" value="<%= service.id %>" class="sr-only" data-action="change->auto-submit#submit" <%= "checked" if service == @service %>>
            <span class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center flex-none group-has-checked:bg-emerald-600 group-has-checked:text-white transition">
              <%= render "icons/pill", size: 18 %>
            </span>
            <span class="flex-1">
              <span class="block text-sm font-medium text-gray-900"><%= service.name %></span>
              <span class="block text-xs text-gray-500">
                <%= service.duration_minutes %> min
                <% if service.price.present? %> &middot; <%= number_to_currency(service.price, unit: "₱", precision: 2) %><% end %>
              </span>
            </span>
            <span class="w-5 h-5 rounded-full border border-gray-300 flex items-center justify-center flex-none text-xs text-transparent group-has-checked:bg-emerald-600 group-has-checked:border-emerald-600 group-has-checked:text-white">✓</span>
          </label>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= render "shared/form_field", name: "date", value: @date&.iso8601, label: "Date", type: :date,
        html_options: { min: Date.current.iso8601, data: { action: "change->auto-submit#submit" } } %>
<% end %>

<%= form_with url: staff_appointments_path, method: :post, class: "flex flex-col gap-5 mt-5" do |f| %>
  <%= f.hidden_field :service_id, value: @service&.id %>
  <%= f.hidden_field :date, value: @date&.iso8601 %>

  <div data-controller="staff-patient-search">
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Patient</label>
    <% if @patients.empty? %>
      <p class="text-sm text-gray-500">No patients registered yet.</p>
    <% else %>
      <div class="relative mb-2">
        <%= render "icons/search", size: 16, class: "absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400" %>
        <input type="text" placeholder="Search patients..." autocomplete="off"
          data-staff-patient-search-target="input" data-action="input->staff-patient-search#filter"
          class="w-full bg-white border border-gray-300 rounded-lg pl-10 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
      </div>
      <div class="flex flex-col gap-2 max-h-64 overflow-y-auto">
        <% @patients.each do |patient| %>
          <label class="group relative flex items-center gap-3 border border-gray-200 rounded-xl px-3 py-2.5 cursor-pointer shadow-sm has-checked:border-emerald-600 has-checked:bg-emerald-50 transition"
                data-staff-patient-search-target="item" data-patient-search-name="<%= [ patient.display_name, patient.email ].join(" ").downcase %>">
            <input type="radio" name="patient_id" value="<%= patient.id %>" class="sr-only" <%= "checked" if @patient_id == patient.id.to_s %>>
            <span class="w-8 h-8 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-semibold flex-none"><%= initials_for(patient) %></span>
            <span class="flex-1 min-w-0">
              <span class="block text-sm font-medium text-gray-900 truncate"><%= patient.display_name %></span>
              <span class="block text-xs text-gray-500 truncate"><%= patient.email %></span>
            </span>
            <span class="w-5 h-5 rounded-full border border-gray-300 flex items-center justify-center flex-none text-xs text-transparent group-has-checked:bg-emerald-600 group-has-checked:border-emerald-600 group-has-checked:text-white">✓</span>
          </label>
        <% end %>
        <p data-staff-patient-search-target="empty" class="hidden text-center text-sm text-gray-400 py-4">No patients found.</p>
      </div>
    <% end %>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Doctor</label>
    <div class="flex flex-col gap-2">
      <label class="group relative flex items-center gap-3 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer shadow-sm has-checked:border-emerald-600 has-checked:bg-emerald-50 transition">
        <input type="radio" name="staff_id" value="" class="sr-only" <%= "checked" if @staff_id.blank? %>>
        <span class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 flex-none">
          <%= render "icons/users", size: 18 %>
        </span>
        <span class="flex-1 text-sm font-medium text-gray-900">Anyone / No preference</span>
        <span class="w-5 h-5 rounded-full border border-gray-300 flex items-center justify-center flex-none text-xs text-transparent group-has-checked:bg-emerald-600 group-has-checked:border-emerald-600 group-has-checked:text-white">✓</span>
      </label>
      <% @clinic_staffs.each do |clinic_staff| %>
        <% staff = clinic_staff.user %>
        <label class="group relative flex items-center gap-3 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer shadow-sm has-checked:border-emerald-600 has-checked:bg-emerald-50 transition">
          <input type="radio" name="staff_id" value="<%= staff.id %>" class="sr-only" <%= "checked" if @staff_id == staff.id.to_s %>>
          <span class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center text-sm font-semibold flex-none"><%= staff.display_name.first.upcase %></span>
          <span class="flex-1">
            <span class="block text-sm font-medium text-gray-900"><%= staff.display_name %></span>
            <span class="block text-xs text-gray-500"><%= clinic_staff.owner? ? "Clinic Owner" : "Staff" %></span>
          </span>
          <span class="w-5 h-5 rounded-full border border-gray-300 flex items-center justify-center flex-none text-xs text-transparent group-has-checked:bg-emerald-600 group-has-checked:border-emerald-600 group-has-checked:text-white">✓</span>
        </label>
      <% end %>
    </div>
  </div>

  <div>
    <label class="block text-sm font-medium text-gray-700 mb-1.5">Time</label>
    <% if @service.nil? %>
      <p class="text-sm text-gray-500">Pick a service first.</p>
    <% elsif @date.nil? %>
      <p class="text-sm text-gray-500">Pick a date first.</p>
    <% else %>
      <% available_slots = @slots.select(&:available).map { |s| [ s.starts_at.strftime("%-I:%M %p"), s.starts_at.iso8601 ] }.uniq { |_, value| value } %>
      <% if available_slots.empty? %>
        <p class="text-gray-500 text-sm text-center py-6 bg-gray-50 rounded-xl">No available time slots on this day.</p>
      <% else %>
        <div class="grid grid-cols-3 gap-2">
          <% available_slots.each do |label, value| %>
            <label class="relative flex items-center justify-center border border-gray-200 rounded-xl py-2.5 text-sm font-medium text-gray-700 cursor-pointer shadow-sm has-checked:border-emerald-600 has-checked:bg-emerald-600 has-checked:text-white transition">
              <input type="radio" name="starts_at" value="<%= value %>" class="sr-only">
              <%= label %>
            </label>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>

  <%= render "shared/form_field", form: f, attribute: :notes, label: "Notes (Optional)", type: :textarea,
        placeholder: "Add notes" %>

  <%= f.submit "Save Appointment", class: "w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-xl cursor-pointer transition" %>
<% end %>
