<% content_for(:page_title, "Mark Unavailable") %>
<% content_for(:back_path, staff_doctors_path) %>

<div class="flex items-center gap-3 mb-5">
  <span class="w-11 h-11 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center text-sm font-semibold flex-none"><%= initials_for(@doctor.user) %></span>
  <div class="min-w-0">
    <p class="text-sm font-semibold text-gray-900 truncate"><%= @doctor.user.display_name %></p>
    <p class="text-xs text-gray-500 truncate"><%= @doctor.specialization.presence || (@doctor.owner? ? "Clinic Owner" : "Staff") %></p>
  </div>
</div>

<p class="text-sm text-gray-500 mb-5">
  Any active appointments with <%= @doctor.user.display_name %> in this range will be cancelled, and affected patients will be emailed right away.
</p>

<%= form_with url: staff_doctor_unavailability_path(@doctor), method: :post, class: "flex flex-col gap-5" do %>
  <div class="grid grid-cols-2 gap-3">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1.5" for="from_date">From</label>
      <input type="date" name="from_date" id="from_date" value="<%= Date.current.iso8601 %>"
        class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500">
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1.5" for="to_date">To</label>
      <input type="date" name="to_date" id="to_date" value="<%= Date.current.iso8601 %>"
        class="w-full rounded-lg border border-gray-300 px-3 py-2 focus:outline-none focus:ring-2 focus:ring-emerald-500">
    </div>
  </div>

  <%= submit_tag "Mark Unavailable & Notify Patients",
        data: { turbo_confirm: "This will cancel any active appointments in range and email affected patients. Continue?" },
        class: "w-full bg-red-50 border border-red-300 text-red-700 font-medium py-2.5 rounded-xl cursor-pointer hover:bg-red-100 transition" %>
<% end %>
