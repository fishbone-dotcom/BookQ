<div class="w-full max-w-2xl mx-auto">
  <%= link_to root_path, class: "inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700 mb-4" do %>
    ← Back
  <% end %>

  <h1 class="text-2xl font-bold text-gray-900 mb-1"><%= @clinic.name %></h1>
  <p class="text-gray-500 text-sm mb-6"><%= @clinic.address %></p>

  <% if @active_appointment && !@editing_appointment %>
    <div class="bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-lg px-4 py-3 text-sm">
      <p class="mb-3">
        You already have an active booking (<%= @active_appointment.service.name %> at <%= @active_appointment.clinic.name %>,
        <%= I18n.l(@active_appointment.starts_at, format: :long) %>). Only one active booking is allowed per patient —
        cancel it first before booking again.
      </p>
      <%= button_to "Cancel booking", cancel_appointment_path(@active_appointment), method: :patch,
            data: { turbo_confirm: "Are you sure you want to cancel this booking? This cannot be undone." },
            class: "bg-red-50 border border-red-300 text-red-700 font-medium px-4 py-2 rounded-lg text-sm cursor-pointer hover:bg-red-100 transition" %>
    </div>
  <% elsif @services.empty? %>
    <p class="text-gray-500 text-sm">This clinic doesn't have any services yet.</p>
  <% elsif @service.nil? %>
    <p class="text-gray-500 text-sm">This clinic doesn't have any services yet.</p>
  <% else %>
    <% if @editing_appointment %>
      <div class="flex items-center justify-between gap-3 mb-5 bg-gray-50 border border-gray-200 rounded-lg px-4 py-3">
        <p class="text-sm text-gray-600">Reschedule your appointment below, or cancel it.</p>
        <%= button_to "Cancel booking", cancel_appointment_path(@editing_appointment), method: :patch,
              data: { turbo_confirm: "Are you sure you want to cancel this booking? This cannot be undone." },
              class: "bg-red-50 border border-red-300 text-red-700 font-medium px-3 py-1.5 rounded-lg text-sm cursor-pointer hover:bg-red-100 transition shrink-0" %>
      </div>
    <% end %>
    <div data-controller="booking-wizard" data-booking-wizard-step-value="<%= @editing_appointment && @date.present? ? 4 : (@date.present? ? 3 : (params[:service_id].present? ? 2 : 1)) %>">

      <!-- Step indicator -->
      <div class="relative mb-8">
        <div class="absolute top-3.5 left-0 right-0 h-0.5 bg-gray-200" style="margin-inline: 12.5%;"></div>
        <div data-booking-wizard-target="progressLine" class="absolute top-3.5 left-0 h-0.5 bg-emerald-600 transition-all" style="margin-inline-start: 12.5%; width: 0%;"></div>
        <div class="relative flex justify-between">
          <% [ [ 1, "Service" ], [ 2, "Doctor" ], [ 3, "Schedule" ], [ 4, "Confirm" ] ].each do |step, label| %>
            <div data-booking-wizard-target="stepIndicator" data-step="<%= step %>" class="flex flex-col items-center gap-1 flex-1">
              <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold step-circle">
                <%= step %>
              </div>
              <span class="text-[11px] text-gray-500 step-label"><%= label %></span>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Step 1: Service (own GET form — changing service needs a real reload) -->
      <div data-booking-wizard-target="stepPanel" data-step="1">
        <%= form_with url: clinic_booking_path(@clinic), method: :get, data: { "booking-wizard-target": "serviceForm" }, class: "flex flex-col gap-2" do |f| %>
          <% @services.each do |service| %>
            <label class="group relative flex items-center gap-3 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer shadow-sm has-checked:border-emerald-600 has-checked:bg-emerald-50 transition">
              <input type="radio" name="service_id" value="<%= service.id %>" class="sr-only" <%= "checked" if service == @service %>>
              <span class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center flex-none group-has-checked:bg-emerald-600 group-has-checked:text-white transition">
                <%= render "icons/pill", size: 18 %>
              </span>
              <span class="flex-1">
                <span class="block text-sm font-medium text-gray-900"><%= service.name %></span>
                <span class="block text-xs text-gray-500">
                  <%= service.duration_minutes %> min
                  <% if service.price.present? %> &middot; <%= number_to_currency(service.price, unit: "₱", precision: 2) %><% end %>
                </span>
              </span>
              <span class="w-5 h-5 rounded-full border border-gray-300 flex items-center justify-center flex-none text-xs text-transparent group-has-checked:bg-emerald-600 group-has-checked:border-emerald-600 group-has-checked:text-white">✓</span>
            </label>
          <% end %>
          <%= f.hidden_field :month, value: @month.strftime("%Y-%m") %>
          <%= f.hidden_field :staff_id, value: @staff_id %>
        <% end %>
      </div>

      <%= form_with url: @editing_appointment ? appointment_path(@editing_appointment) : clinic_booking_path(@clinic),
            method: @editing_appointment ? :patch : :post, data: { "booking-wizard-target": "bookingForm", turbo_frame: "_top" } do |f| %>
        <%= f.hidden_field :service_id, value: @service.id %>
        <%= f.hidden_field :month, value: @month.strftime("%Y-%m") %>
        <%= f.hidden_field :date, value: @date&.iso8601, data: { "booking-wizard-target": "hiddenDate" } %>

        <!-- Step 2: Doctor (client-side only — availability isn't per-doctor yet) -->
        <div data-booking-wizard-target="stepPanel" data-step="2" class="flex flex-col gap-2">
          <label class="group relative flex items-center gap-3 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer shadow-sm has-checked:border-emerald-600 has-checked:bg-emerald-50 transition">
            <input type="radio" name="staff_id" value="" class="sr-only" data-name="Anyone" <%= "checked" if @staff_id.blank? %>>
            <span class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 flex-none">
              <%= render "icons/users", size: 18 %>
            </span>
            <span class="flex-1 text-sm font-medium text-gray-900">Anyone / No preference</span>
            <span class="w-5 h-5 rounded-full border border-gray-300 flex items-center justify-center flex-none text-xs text-transparent group-has-checked:bg-emerald-600 group-has-checked:border-emerald-600 group-has-checked:text-white">✓</span>
          </label>
          <% @clinic_staffs.each do |clinic_staff| %>
            <% staff = clinic_staff.user %>
            <label class="group relative flex items-center gap-3 border border-gray-200 rounded-xl px-4 py-3 cursor-pointer shadow-sm has-checked:border-emerald-600 has-checked:bg-emerald-50 transition">
              <input type="radio" name="staff_id" value="<%= staff.id %>" class="sr-only" data-name="<%= staff.display_name %>" <%= "checked" if @staff_id == staff.id.to_s %>>
              <span class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-700 flex items-center justify-center text-sm font-semibold flex-none"><%= staff.display_name.first.upcase %></span>
              <span class="flex-1">
                <span class="block text-sm font-medium text-gray-900"><%= staff.display_name %></span>
                <span class="block text-xs text-gray-500"><%= clinic_staff.owner? ? "Clinic Owner" : "Staff" %></span>
              </span>
              <span class="w-5 h-5 rounded-full border border-gray-300 flex items-center justify-center flex-none text-xs text-transparent group-has-checked:bg-emerald-600 group-has-checked:border-emerald-600 group-has-checked:text-white">✓</span>
            </label>
          <% end %>
        </div>

        <!-- Step 3: Schedule -->
        <div data-booking-wizard-target="stepPanel" data-step="3">
          <div class="flex items-center justify-between mb-3">
            <%= link_to "← #{(@month - 1.month).strftime('%b')}", clinic_booking_path(@clinic, month: (@month - 1.month).strftime("%Y-%m"), service_id: @service.id, staff_id: @staff_id), class: "text-emerald-600 hover:underline text-sm py-2 px-1 -mx-1" %>
            <span class="font-semibold text-gray-900"><%= @month.strftime("%B %Y") %></span>
            <%= link_to "#{(@month + 1.month).strftime('%b')} →", clinic_booking_path(@clinic, month: (@month + 1.month).strftime("%Y-%m"), service_id: @service.id, staff_id: @staff_id), class: "text-emerald-600 hover:underline text-sm py-2 px-1 -mx-1" %>
          </div>

          <div class="grid grid-cols-7 gap-1 text-center text-xs font-medium text-gray-400 mb-1">
            <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |d| %>
              <div><%= d %></div>
            <% end %>
          </div>

          <div class="grid grid-cols-7 gap-1 mb-4">
            <% @month.beginning_of_month.wday.times do %>
              <div></div>
            <% end %>
            <% @calendar_days.each do |day| %>
              <% resting_class = day[:available] ? "bg-white text-gray-900 hover:bg-emerald-50 border border-gray-200" : "bg-gray-50 text-gray-400 border border-gray-100" %>
              <% resting_dot_class = day[:available] ? "bg-green-500" : "bg-red-400" %>
              <%= link_to clinic_booking_path(@clinic, month: @month.strftime("%Y-%m"), date: day[:date].iso8601, service_id: @service.id, staff_id: @staff_id),
                    data: { turbo_frame: "slots", action: "click->booking-wizard#selectDate", date: day[:date].iso8601, label: day[:date].strftime("%A, %B %-d"), "resting-class": resting_class },
                    "data-booking-wizard-target": "dateCell",
                    class: "relative flex flex-col items-center justify-center h-11 rounded-lg text-sm #{day[:date] == @date ? 'bg-emerald-600 text-white font-semibold' : resting_class}" do %>
                <span><%= day[:date].day %></span>
                <span class="avail-dot w-1.5 h-1.5 rounded-full mt-0.5 <%= day[:date] == @date ? 'bg-white' : resting_dot_class %>" data-resting-class="<%= resting_dot_class %>"></span>
              <% end %>
            <% end %>
          </div>

          <div class="flex items-center gap-4 mb-4 text-xs text-gray-500">
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-green-500 inline-block"></span> Slots available</span>
            <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-red-400 inline-block"></span> Full / closed</span>
          </div>

          <%= turbo_frame_tag "slots" do %>
            <% if flash[:alert].present? %>
              <p class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-3 py-2 text-sm mb-3"><%= flash[:alert] %></p>
            <% end %>

            <% if @date.present? %>
              <% available_slots = @slots.select(&:available).map { |s| [ s.starts_at.strftime("%-I:%M %p"), s.starts_at.iso8601 ] }.uniq { |_, value| value } %>
              <% if available_slots.empty? %>
                <p class="text-gray-500 text-sm text-center py-6">No available time slots on this day.</p>
              <% else %>
                <div class="grid grid-cols-3 gap-2">
                  <% available_slots.each do |label, value| %>
                    <label class="relative flex items-center justify-center border border-gray-200 rounded-xl py-2.5 text-sm font-medium text-gray-700 cursor-pointer shadow-sm has-checked:border-emerald-600 has-checked:bg-emerald-600 has-checked:text-white transition">
                      <input type="radio" name="starts_at" value="<%= value %>" class="sr-only" data-action="change->booking-wizard#slotChanged" data-label="<%= label %>"
                        <%= "checked" if @editing_appointment && value == @editing_appointment.starts_at.iso8601 %>>
                      <%= label %>
                    </label>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <!-- Step 4: Confirm -->
        <div data-booking-wizard-target="stepPanel" data-step="4">
          <p class="text-sm font-medium text-gray-700 mb-3">Review before confirming</p>
          <dl class="flex flex-col gap-3 text-sm bg-gray-50 border border-gray-200 rounded-xl px-4 py-4 mb-4">
            <div class="flex justify-between gap-3">
              <dt class="text-gray-500">Clinic</dt>
              <dd class="text-gray-900 font-medium text-right"><%= @clinic.name %></dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-gray-500">Service</dt>
              <dd class="text-gray-900 font-medium text-right"><%= @service.name %></dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-gray-500">Doctor</dt>
              <dd class="text-gray-900 font-medium text-right" data-booking-wizard-target="summaryStaff">—</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-gray-500">Date</dt>
              <dd class="text-gray-900 font-medium text-right" data-booking-wizard-target="summaryDate">—</dd>
            </div>
            <div class="flex justify-between gap-3">
              <dt class="text-gray-500">Time</dt>
              <dd class="text-gray-900 font-medium text-right" data-booking-wizard-target="summaryTime">—</dd>
            </div>
            <% if @service.price.present? %>
              <div class="flex justify-between gap-3 items-center pt-3 border-t border-gray-200">
                <dt class="text-gray-700 font-medium">Total Amount</dt>
                <dd class="text-emerald-700 font-bold text-lg"><%= number_to_currency(@service.price, unit: "₱", precision: 2) %></dd>
              </div>
            <% end %>
          </dl>
        </div>

        <!-- Nav buttons -->
        <div class="flex gap-3 mt-2">
          <button type="button" data-booking-wizard-target="backButton" data-action="click->booking-wizard#back"
                class="flex-1 border border-gray-300 text-gray-700 font-medium py-2.5 rounded-xl cursor-pointer hover:bg-gray-50 transition">← Back</button>
          <button type="button" data-booking-wizard-target="nextButton" data-action="click->booking-wizard#next"
                class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-xl cursor-pointer transition disabled:opacity-40 disabled:cursor-not-allowed">Next</button>
          <%= f.submit @editing_appointment ? "Update" : "Book", data: { "booking-wizard-target": "submitButton" }, class: "flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-xl cursor-pointer transition hidden" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
