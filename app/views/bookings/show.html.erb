<div class="w-full max-w-2xl mx-auto bg-white rounded-xl shadow-sm border border-gray-200 p-8">
  <h1 class="text-2xl font-bold text-gray-900 mb-1"><%= @clinic.name %></h1>
  <p class="text-gray-500 text-sm mb-6"><%= @clinic.address %></p>

  <% if @services.empty? %>
    <p class="text-gray-500 text-sm">Wala pang service ang clinic na ito.</p>
  <% else %>
    <%= form_with url: clinic_booking_path(@clinic), method: :get, class: "mb-6" do |f| %>
      <%= f.label :service_id, "Service", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :service_id,
            @services.map { |s| ["#{s.name} (#{s.duration_minutes} min)", s.id] },
            { selected: @service&.id },
            class: "w-full rounded-lg border border-gray-300 px-3 py-2",
            onchange: "this.form.requestSubmit()" %>
      <%= f.hidden_field :date, value: @date.iso8601 %>
    <% end %>

    <div class="flex items-center justify-between mb-4">
      <%= link_to "← Prev day", clinic_booking_path(@clinic, date: (@date - 1).iso8601, service_id: @service&.id), class: "text-blue-600 hover:underline text-sm" %>
      <span class="font-medium text-gray-900"><%= @date.strftime("%A, %B %-d") %></span>
      <%= link_to "Next day →", clinic_booking_path(@clinic, date: (@date + 1).iso8601, service_id: @service&.id), class: "text-blue-600 hover:underline text-sm" %>
    </div>

    <% if @slots.empty? %>
      <p class="text-gray-500 text-sm text-center py-6">Sarado ang clinic sa araw na ito.</p>
    <% else %>
      <div class="grid grid-cols-3 gap-2">
        <% @slots.each do |slot| %>
          <% if slot.available %>
            <%= button_to slot.starts_at.strftime("%-I:%M %p"),
                  clinic_booking_path(@clinic),
                  params: { service_id: @service.id, starts_at: slot.starts_at.iso8601, date: @date.iso8601 },
                  class: "bg-blue-50 hover:bg-blue-100 text-blue-700 text-sm font-medium py-2 rounded-lg border border-blue-200 cursor-pointer transition" %>
          <% else %>
            <span class="bg-gray-50 text-gray-400 text-sm font-medium py-2 rounded-lg border border-gray-200 text-center">
              <%= slot.starts_at.strftime("%-I:%M %p") %>
            </span>
          <% end %>
        <% end %>
      </div>

      <div class="flex items-center gap-4 mt-6 text-xs text-gray-500">
        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-blue-50 border border-blue-200 inline-block"></span> Available</span>
        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-gray-50 border border-gray-200 inline-block"></span> Hindi available</span>
      </div>
    <% end %>
  <% end %>
</div>
