<p>Hi <%= @appointment.contact_name %>,</p>

<p>Your appointment is confirmed:</p>

<ul>
  <li><strong>Clinic:</strong> <%= @clinic.name %></li>
  <li><strong>Service:</strong> <%= @service.name %></li>
  <% if @appointment.staff.present? %>
    <li><strong>With:</strong> <%= @appointment.staff.name.presence || @appointment.staff.email %></li>
  <% end %>
  <li><strong>When:</strong> <%= @appointment.starts_at.strftime("%A, %B %-d, %Y at %-I:%M %p") %></li>
  <% if @clinic.address.present? %>
    <li><strong>Address:</strong> <%= @clinic.address %></li>
  <% end %>
</ul>

<% if @appointment.guest? %>
  <p>You can view, manage, or cancel this booking anytime here: <%= link_to "Manage your appointment", guest_appointment_url(@appointment.signed_id(purpose: :guest_management, expires_in: 60.days)) %></p>
  <p>Want your appointment history and faster booking next time? <%= link_to "Create a free BookQ account", new_user_registration_url(email: @appointment.guest_email) %>.</p>
<% else %>
  <p>You can manage this booking anytime from your BookQ account.</p>
<% end %>
